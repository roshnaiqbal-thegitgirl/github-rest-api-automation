{
  "info": {
    "name": "GitHub API Test Suite",
    "description": "Comprehensive test automation suite for GitHub REST API v3. Covers repository operations, user management, issues, pull requests, and error handling scenarios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Setup & Auth",
      "item": [
        {
          "name": "Set Auth Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('github_token', pm.environment.get('GITHUB_TOKEN') || pm.collectionVariables.get('github_token'));",
                  "pm.collectionVariables.set('github_user', pm.environment.get('GITHUB_USER') || pm.collectionVariables.get('github_user') || 'octocat');",
                  "pm.collectionVariables.set('base_url', 'https://api.github.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Auth token is valid', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token grants access to authenticated user', function() {",
                  "  const user = pm.response.json();",
                  "  pm.expect(user).to.have.property('login');",
                  "  pm.collectionVariables.set('auth_user', user.login);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        }
      ]
    },
    {
      "name": "User & Profile Tests",
      "item": [
        {
          "name": "Get Authenticated User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Validate successful response",
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// Validate response structure",
                  "pm.test('Response has required user fields', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('login');",
                  "  pm.expect(response).to.have.property('id');",
                  "  pm.expect(response).to.have.property('public_repos');",
                  "  pm.expect(response).to.have.property('followers');",
                  "  pm.expect(response).to.have.property('following');",
                  "});",
                  "",
                  "// Validate data types",
                  "pm.test('User data types are correct', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.login).to.be.a('string');",
                  "  pm.expect(response.id).to.be.a('number');",
                  "  pm.expect(response.public_repos).to.be.a('number');",
                  "});",
                  "",
                  "// Store user login for later tests",
                  "pm.collectionVariables.set('auth_user', pm.response.json().login);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Get User by Username",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('User profile contains expected fields', function() {",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.login).to.equal(pm.variables.get('github_user'));",
                  "  pm.expect(user.type).to.be.oneOf(['User', 'Organization']);",
                  "});",
                  "",
                  "pm.test('User profile data is consistent', function() {",
                  "  const user = pm.response.json();",
                  "  pm.expect(user.public_repos).to.be.at.least(0);",
                  "  pm.expect(user.followers).to.be.at.least(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/users/{{github_user}}",
              "host": ["{{base_url}}"],
              "path": ["users", "{{github_user}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Repository Tests",
      "item": [
        {
          "name": "List User Repositories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function() {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each repository has required fields', function() {",
                  "  const repos = pm.response.json();",
                  "  if (repos.length > 0) {",
                  "    pm.expect(repos[0]).to.have.property('name');",
                  "    pm.expect(repos[0]).to.have.property('url');",
                  "    pm.expect(repos[0]).to.have.property('language');",
                  "    pm.expect(repos[0]).to.have.property('stargazers_count');",
                  "  }",
                  "});",
                  "",
                  "// Store first repo for later tests",
                  "const repos = pm.response.json();",
                  "if (repos.length > 0) {",
                  "  pm.collectionVariables.set('test_repo', repos[0].name);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user/repos?type=owner&sort=updated",
              "host": ["{{base_url}}"],
              "path": ["user", "repos"],
              "query": [
                {
                  "key": "type",
                  "value": "owner"
                },
                {
                  "key": "sort",
                  "value": "updated"
                }
              ]
            }
          }
        },
        {
          "name": "Get Specific Repository",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Repository contains required metadata', function() {",
                  "  const repo = pm.response.json();",
                  "  pm.expect(repo.name).to.be.a('string');",
                  "  pm.expect(repo.owner).to.have.property('login');",
                  "  pm.expect(repo.owner).to.have.property('type');",
                  "});",
                  "",
                  "pm.test('Repository has valid visibility', function() {",
                  "  const repo = pm.response.json();",
                  "  pm.expect(repo.private).to.be.a('boolean');",
                  "  pm.expect(['public', 'private']).to.include(repo.visibility);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repos/{{auth_user}}/{{test_repo}}",
              "host": ["{{base_url}}"],
              "path": ["repos", "{{auth_user}}", "{{test_repo}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Issues & Pull Requests",
      "item": [
        {
          "name": "List Repository Issues",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function() {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Issues have required fields when present', function() {",
                  "  const issues = pm.response.json();",
                  "  if (issues.length > 0) {",
                  "    pm.expect(issues[0]).to.have.property('number');",
                  "    pm.expect(issues[0]).to.have.property('title');",
                  "    pm.expect(issues[0]).to.have.property('state');",
                  "    pm.expect(['open', 'closed']).to.include(issues[0].state);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repos/{{auth_user}}/{{test_repo}}/issues?state=all",
              "host": ["{{base_url}}"],
              "path": ["repos", "{{auth_user}}", "{{test_repo}}", "issues"],
              "query": [
                {
                  "key": "state",
                  "value": "all"
                }
              ]
            }
          }
        },
        {
          "name": "List Pull Requests",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an array', function() {",
                  "  pm.expect(pm.response.json()).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Pull requests have required fields', function() {",
                  "  const prs = pm.response.json();",
                  "  if (prs.length > 0) {",
                  "    pm.expect(prs[0]).to.have.property('number');",
                  "    pm.expect(prs[0]).to.have.property('title');",
                  "    pm.expect(prs[0]).to.have.property('state');",
                  "    pm.expect(prs[0]).to.have.property('created_at');",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repos/{{auth_user}}/{{test_repo}}/pulls?state=all",
              "host": ["{{base_url}}"],
              "path": ["repos", "{{auth_user}}", "{{test_repo}}", "pulls"],
              "query": [
                {
                  "key": "state",
                  "value": "all"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Search & Filtering",
      "item": [
        {
          "name": "Search Repositories by Language",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Search response has expected structure', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('total_count');",
                  "  pm.expect(response).to.have.property('items');",
                  "  pm.expect(response.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Search results contain only specified language', function() {",
                  "  const response = pm.response.json();",
                  "  response.items.forEach(repo => {",
                  "    if (repo.language !== null) {",
                  "      pm.expect(repo.language).to.equal('Python');",
                  "    }",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search/repositories?q=language:Python&sort=stars&order=desc&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["search", "repositories"],
              "query": [
                {
                  "key": "q",
                  "value": "language:Python"
                },
                {
                  "key": "sort",
                  "value": "stars"
                },
                {
                  "key": "order",
                  "value": "desc"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Search Issues with Filters",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Search returns structured response', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response.total_count).to.be.at.least(0);",
                  "  pm.expect(response.items).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('All results match filter criteria', function() {",
                  "  const response = pm.response.json();",
                  "  response.items.forEach(issue => {",
                  "    pm.expect(issue.state).to.equal('open');",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/search/issues?q=state:open+label:bug&sort=updated&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["search", "issues"],
              "query": [
                {
                  "key": "q",
                  "value": "state:open+label:bug"
                },
                {
                  "key": "sort",
                  "value": "updated"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Error Handling & Edge Cases",
      "item": [
        {
          "name": "Invalid Token - 401 Unauthorized",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function() {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "",
                  "pm.test('Error response contains message', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('message');",
                  "  pm.expect(response.message).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "invalid_token_12345",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        },
        {
          "name": "Not Found - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function() {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('Error response is valid', function() {",
                  "  const response = pm.response.json();",
                  "  pm.expect(response).to.have.property('message');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/repos/{{auth_user}}/nonexistent-repo-12345",
              "host": ["{{base_url}}"],
              "path": ["repos", "{{auth_user}}", "nonexistent-repo-12345"]
            }
          }
        },
        {
          "name": "Rate Limit Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response includes rate limit headers', function() {",
                  "  pm.expect(pm.response.headers.has('x-ratelimit-limit')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('x-ratelimit-remaining')).to.be.true;",
                  "  pm.expect(pm.response.headers.has('x-ratelimit-reset')).to.be.true;",
                  "});",
                  "",
                  "pm.test('Rate limit is within acceptable range', function() {",
                  "  const remaining = parseInt(pm.response.headers.get('x-ratelimit-remaining'));",
                  "  const limit = parseInt(pm.response.headers.get('x-ratelimit-limit'));",
                  "  pm.expect(remaining).to.be.at.most(limit);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{github_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github.v3+json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": ["{{base_url}}"],
              "path": ["user"]
            }
          }
        }
      ]
    },
